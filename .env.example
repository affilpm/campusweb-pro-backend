# Django Configuration
SECRET_KEY=django-insecure-change-this-in-production-with-secure-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,api.novelschoolindia.com

# Database (PostgreSQL)
POSTGRES_DB=school_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=secure_password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# CORS & CSRF
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://novelschoolindia.com
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://api.novelschoolindia.com,https://novelschoolindia.com

# JWT Settings
ACCESS_TOKEN_LIFETIME_MINUTES=30
REFRESH_TOKEN_LIFETIME_DAYS=7

# Cloudflare R2 Configuration (Primary Storage)
R2_ACCESS_KEY_ID=your-r2-access-key
R2_SECRET_ACCESS_KEY=your-r2-secret-key
R2_BUCKET_NAME=school
R2_ENDPOINT_URL=https://your-r2-account-id.r2.cloudflarestorage.com
R2_CUSTOM_DOMAIN=https://media.novelschoolindia.com

# AWS S3 (Backup/Legacy)
USE_AWS=False
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=your-bucket-name
AWS_S3_REGION_NAME=us-east-1
CLOUDFRONT_DOMAIN=your-cloudfront-id.cloudfront.net
